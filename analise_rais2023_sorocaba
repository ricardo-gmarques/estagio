        "# Comparação por CBO com padrão correto\n",
        "\n",
        "def comparacao_cbo(df_base):\n",
        "    grupo = df_base.groupby(['cbo_nome', 'sexo trabalhador'])['vl remun média nom']\n",
        "\n",
        "    media = grupo.mean().unstack()\n",
        "    mediana = grupo.median().unstack()\n",
        "\n",
        "    resultado = pd.DataFrame()\n",
        "\n",
        "    resultado['Média FEM'] = media.get('Feminino')\n",
        "    resultado['Média MASC'] = media.get('Masculino')\n",
        "    resultado['Dif Média (%)'] = ((resultado['Média FEM'] - resultado['Média MASC']) / resultado['Média MASC']) * 100\n",
        "\n",
        "    resultado['Mediana FEM'] = mediana.get('Feminino')\n",
        "    resultado['Mediana MASC'] = mediana.get('Masculino')\n",
        "    resultado['Dif Mediana (%)'] = ((resultado['Mediana FEM'] - resultado['Mediana MASC']) / resultado['Mediana MASC']) * 100\n",
        "\n",
        "    return resultado\n",
        "\n",
        "sp_cbo = comparacao_cbo(df)\n",
        "sor_cbo = comparacao_cbo(df_sorocaba)\n",
        "\n",
        "comparacao_final_cbo = pd.concat(\n",
        "    [sp_cbo.add_suffix(' SP'), sor_cbo.add_suffix(' Sorocaba')],\n",
        "    axis=1\n",
        ").round(2)\n",
        "\n",
        "comparacao_final_cbo"
