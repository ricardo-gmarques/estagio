      "source": [
        "# Comparação geral por sexo (SP vs Sorocaba)\n",
        "\n",
        "def resumo_sexo(df_base):\n",
        "    grupo = df_base.groupby('sexo trabalhador')['vl remun média nom']\n",
        "\n",
        "    media = grupo.mean()\n",
        "    mediana = grupo.median()\n",
        "\n",
        "    fem_media = media.get('Feminino', np.nan)\n",
        "    masc_media = media.get('Masculino', np.nan)\n",
        "\n",
        "    fem_mediana = mediana.get('Feminino', np.nan)\n",
        "    masc_mediana = mediana.get('Masculino', np.nan)\n",
        "\n",
        "    diff_media = ((fem_media - masc_media) / masc_media) * 100\n",
        "    diff_mediana = ((fem_mediana - masc_mediana) / masc_mediana) * 100\n",
        "\n",
        "    return pd.Series({\n",
        "        'Média FEM': fem_media,\n",
        "        'Média MASC': masc_media,\n",
        "        'Dif Média (%)': diff_media,\n",
        "        'Mediana FEM': fem_mediana,\n",
        "        'Mediana MASC': masc_mediana,\n",
        "        'Dif Mediana (%)': diff_mediana\n",
        "    })\n",
        "\n",
        "comparacao_sexo = pd.DataFrame({\n",
        "    'SP': resumo_sexo(df),\n",
        "    'Sorocaba': resumo_sexo(df_sorocaba)\n",
        "}).T.round(2)\n",
