        "# Função para calcular os 25% mais pobres\n",
        "\n",
        "def base_25(df_base):\n",
        "    # Define limite dos 25% mais pobres\n",
        "    limite = df_base['vl remun média nom'].quantile(0.25)\n",
        "\n",
        "    # Filtra os mais pobres\n",
        "    pobres = df_base[df_base['vl remun média nom'] <= limite]\n",
        "\n",
        "    # Contagem por sexo\n",
        "    contagem = pobres.groupby('sexo trabalhador').size()\n",
        "\n",
        "    # Percentual\n",
        "    percentual = (contagem / contagem.sum()) * 100\n",
        "\n",
        "    return contagem, percentual"
      ],
